# Application
APP_NAME=Flux Analysis Automator
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api

# PostgreSQL — Docker maps host 5433 → container 5432 (avoids local Postgres on 5432)
DATABASE_URL=postgresql+psycopg2://flux:flux@localhost:5433/flux_analysis

# Materiality defaults (Phase 3+)
MATERIALITY_PCT_THRESHOLD=10.0
MATERIALITY_ABSOLUTE_THRESHOLD=100000000

# LLM (Phase 4+) — never commit real keys
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# SEC EDGAR (Phase 2+)
SEC_USER_AGENT=FluxAnalysisAutomator contact@example.com
